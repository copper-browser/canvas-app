{
  "name": "canvas-app",
  "private": true,
  "version": "1.0.0",
  "description": "Canvas: the infinite, collaborative whiteboard from the Copper browser, as a web app for any browser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --mode web",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "lint": "oxlint",
    "dev:web": "vite --mode web"
  },
  "dependencies": {
    "lib0": "^0.2.119",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6",
    "jsdom": "^30.1.1",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/copper-browser/canvas-app.git"
  }
}
